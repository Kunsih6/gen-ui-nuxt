# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Nuxt maps NUXT_* variables onto `runtimeConfig` in nuxt.config.ts:
#   NUXT_GOOGLE_API_KEY -> runtimeConfig.googleApiKey
#   NUXT_AI_MODEL       -> runtimeConfig.aiModel

# Gemini API key from Google AI Studio (free tier): https://aistudio.google.com/apikey
NUXT_GOOGLE_API_KEY=

# Gemini model id. Change it here if Google retires the free model; no code change needed.
NUXT_AI_MODEL=gemini-3.5-flash-lite
